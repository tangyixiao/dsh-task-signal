{
  "name": "dsh-task-signal",
  "version": "0.1.3",
  "displayName": "任务提示音 · Task Signal",
  "description": "DSH task completion sounds: native background playback, event controls, persistent settings and quiet subagents.",
  "type": "module",
  "license": "MIT",
  "author": "Tangyixiao",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "sound"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./assets/logo.webp"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md",
    "assets/icon.svg",
    "docs/assets",
    "CHANGELOG.md",
    "assets/logo.webp",
    "assets/NOTICE.md",
    "assets/LICENSE-WHALE-ARTWORK",
    "docs/guide.zh-CN.md",
    "docs/guide.en.md",
    "SUPPORT.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.2-rc.3 || 0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangyixiao/dsh-task-signal.git"
  },
  "homepage": "https://github.com/tangyixiao/dsh-task-signal#readme",
  "bugs": {
    "url": "https://github.com/tangyixiao/dsh-task-signal/issues"
  },
  "icon": "./assets/logo.webp"
}
